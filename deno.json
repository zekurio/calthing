{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "@elysiajs/eden": "npm:@elysiajs/eden@1.4.9",
    "@fontsource-variable/google-sans": "npm:@fontsource-variable/google-sans@^5.3.0",
    "@tsconfig/svelte": "npm:@tsconfig/svelte@5.0.8",
    "@types/deno": "npm:@types/deno@2.7.0",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/yaml": "jsr:@std/yaml@1.0.10",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@6.2.4",
    "@tanstack/svelte-query": "npm:@tanstack/svelte-query@6.1.34",
    "elysia": "npm:elysia@1.4.29",
    "svelte": "npm:svelte@5.56.4",
    "svelte-check": "npm:svelte-check@4.7.2",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@7.3.6"
  },
  "tasks": {
    "check": "deno check src/ shared/ tests/ && deno task frontend:check",
    "test": "deno test --allow-env --allow-read tests/",
    "start": "deno run --allow-env --allow-net --allow-read src/main.ts",
    "dev": {
      "dependencies": ["backend:dev", "frontend:dev"]
    },
    "backend:dev": "deno run --env-file=.env --watch --allow-env --allow-net --allow-read src/main.ts -config config.yaml",
    "frontend:dev": "deno run -A vite frontend",
    "frontend:check": "deno run -A svelte-check --tsconfig frontend/tsconfig.json",
    "frontend:build": "deno run -A vite build frontend"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 100,
    "exclude": ["frontend", "tests/fixtures", "vendor"]
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    },
    "exclude": ["frontend", "vendor"]
  },
  "nodeModulesDir": "auto",
  "vendor": true
}
